# Backend
DATABASE_URL=memory
REDIS_URL=redis://localhost:6379
MODEL_PATH=yolov8n-obb.pt
IOU_THRESHOLD=0.40
CONFIDENCE_THRESHOLD=0.45
SMOOTHING_WINDOW=5
CORS_ORIGINS=http://localhost:5173,http://localhost:8090

# Admin portal (portal endpoints need Postgres + Redis; DATABASE_URL=memory
# makes them return 503)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional bcrypt hash; takes precedence over ADMIN_PASSWORD when set
ADMIN_PASSWORD_HASH=
# Where demo-request notifications go; falls back to ADMIN_EMAIL
ADMIN_NOTIFY_EMAIL=
ADMIN_SESSION_TTL=43200
MEMBER_SESSION_TTL=604800

# SMTP — leave SMTP_HOST empty to capture outbound email in the portal outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=Sightline <no-reply@sightline.local>

# Public intake rate limit (per IP, shared by demo + contact forms)
DEMO_RATE_LIMIT=5
DEMO_RATE_WINDOW=3600
TRUST_PROXY=true

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# Local RTSP test stream
SAMPLE_RTSP_URL=rtsp://127.0.0.1:8554/sightline
